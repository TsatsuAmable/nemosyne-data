{
  "name": "nemosyne-data",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate:synthetic": "node scripts/generate-synthetic.mjs",
    "generate:known-answers": "node scripts/generate-known-answers.mjs",
    "generate:metamorphic-nil": "node scripts/generate-metamorphic-nil.mjs",
    "validate": "npm run validate:catalog && npm run validate:known-answers",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "validate:known-answers": "node scripts/validate-known-answers.mjs",
    "lab:typecheck": "tsc --noEmit -p lab/tsconfig.json",
    "lab:experiment": "node --experimental-strip-types lab/engine/run-xr-architecture-experiment.ts",
    "lab:capacity": "node --experimental-strip-types lab/engine/run-local-capacity-envelope.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0"
  }
}
