{
  "name": "nemosyne-data",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate:synthetic": "node scripts/generate-synthetic.mjs",
    "generate:known-answers": "node scripts/generate-known-answers.mjs",
    "generate:metamorphic-nil": "node scripts/generate-metamorphic-nil.mjs",
    "validate": "npm run validate:catalog && npm run validate:known-answers",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "validate:known-answers": "node scripts/validate-known-answers.mjs",
    "lab:typecheck": "tsc --noEmit -p lab/tsconfig.json",
    "lab:experiment": "node --experimental-strip-types lab/engine/run-xr-architecture-experiment.ts",
    "lab:capacity": "node --experimental-strip-types lab/engine/run-local-capacity-envelope.ts",
    "lab:scheduler:selftest": "node --experimental-strip-types lab/scheduler/scheduler-selftest.ts",
    "lab:scheduler:index": "node --experimental-strip-types lab/scheduler/index-native-evidence.ts",
    "lab:scheduler:impact-selftest": "node --experimental-strip-types lab/scheduler/change-impact-selftest.ts",
    "lab:evidence:selftest": "node --experimental-strip-types lab/evidence/evidence-selftest.ts",
    "lab:control:selftest": "node --experimental-strip-types lab/control/control-selftest.ts",
    "lab:distributed:selftest": "node --experimental-strip-types lab/distributed/worker-protocol-selftest.ts",
    "lab:coordinator:selftest": "node --experimental-strip-types lab/distributed/coordinator-selftest.ts",
    "lab:http:selftest": "node --experimental-strip-types lab/distributed/http-selftest.ts",
    "lab:coordinator": "node --experimental-strip-types lab/distributed/run-coordinator.ts",
    "lab:worker:canary": "node --experimental-strip-types lab/distributed/run-worker-canary.ts",
    "lab:parity:selftest": "node --experimental-strip-types lab/parity-selftest.ts",
    "lab:orchestration:selftest": "node --experimental-strip-types lab/distributed/orchestration-selftest.ts",
    "lab:work:submit": "node --experimental-strip-types lab/scheduler/submit-change-work.ts",
    "lab:worker": "node --experimental-strip-types lab/distributed/run-native-worker.ts",
    "lab:worker:selftest": "node --experimental-strip-types lab/distributed/native-adapter-selftest.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0"
  }
}
